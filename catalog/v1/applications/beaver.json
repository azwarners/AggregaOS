{
  "id": "beaver",
  "display_name": "Beaver Habit Tracker",
  "description": "Beaver Habit Tracker curated application entry.",
  "ownership": "third-party",
  "category": "habits",
  "source": {
    "name": "daya0576/beaverhabits",
    "upstream": "https://github.com/daya0576/beaverhabits"
  },
  "version": "0.10.0",
  "status": "supported",
  "install_methods": [
    "oci-container"
  ],
  "capabilities": {
    "install": true,
    "update": true,
    "remove": true,
    "verify": true
  },
  "unsupported_operations": [
    "automatic-backup"
  ],
  "entry_point": "ansible/playbooks/beaver.yml",
  "deployments": [
    {
      "method": "oci-container",
      "backend": "ansible",
      "entry_point": "ansible/playbooks/beaver.yml",
      "requirements": [
        "system:podman"
      ],
      "reference": "daya0576/beaverhabits:0.10.0",
      "image": "daya0576/beaverhabits:0.10.0"
    }
  ],
  "platforms": [
    {
      "name": "ubuntu",
      "versions": [
        "24.04"
      ],
      "architectures": [
        "amd64",
        "arm64"
      ]
    }
  ],
  "dependencies": [
    "system:podman"
  ],
  "conflicts": [],
  "services": [
    {
      "name": "beaver.service",
      "ports": [
        8082
      ],
      "data_paths": [
        "/var/lib/aggregare/beaver"
      ],
      "endpoints": [
        "http://127.0.0.1:8082"
      ]
    }
  ],
  "configuration": [
    {
      "name": "HABITS_STORAGE",
      "type": "string",
      "required": true
    }
  ],
  "secret_references": [],
  "integrations": []
}
