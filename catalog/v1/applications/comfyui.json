{
  "id": "comfyui",
  "display_name": "ComfyUI",
  "description": "ComfyUI curated application entry.",
  "ownership": "third-party",
  "category": "ai-image-generation",
  "source": {
    "name": "Comfy-Org/ComfyUI",
    "upstream": "https://github.com/Comfy-Org/ComfyUI"
  },
  "version": "0.38.0",
  "status": "supported",
  "install_methods": [
    "native-python"
  ],
  "capabilities": {
    "install": true,
    "update": true,
    "remove": true,
    "verify": true
  },
  "unsupported_operations": [
    "gpu-configuration"
