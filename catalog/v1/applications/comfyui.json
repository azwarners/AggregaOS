  "entry_point": "ansible/playbooks/comfyui.yml",
  "deployments": [
    {
      "method": "native-python",
      "backend": "ansible",
      "entry_point": "ansible/playbooks/comfyui.yml",
      "reference": "v0.38.0",
      "requirements": [
        "system:git",
        "system:python3",
        "system:python3-venv",
        "pytorch-cpu"
      ]
    }
  ],
  "platforms": [
    {
      "name": "ubuntu",
      "versions": [
        "24.04"
      ],
      "architectures": [
        "amd64",
        "arm64"
      ]
    }
  ],
  "dependencies": [
    "system:git",
    "system:python3",
    "system:python3-venv"
  ],
  "conflicts": [],
  "services": [
    {
      "name": "comfyui.service",
      "ports": [
        8188
      ],
      "data_paths": [
        "/var/lib/aggregare/comfyui"
      ],
      "endpoints": [
        "http://127.0.0.1:8188"
      ]
    }
  ],
  "secret_references": [],
  "integrations": [
    "llama.cpp"
  ]
}
